# Database connection string provided by the expense_tracker_database container.
# Example for PostgreSQL:
# DB_URL=postgresql+psycopg2://user:password@hostname:5432/expense_db
DB_URL=

# JWT secret used to sign access tokens
JWT_SECRET_KEY=change-this-secret

# Access token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRES_MIN=60

# CORS allowed origins (comma-separated). Use * to allow all.
CORS_ORIGINS=*

# Optional: Customize API metadata and docs path
API_TITLE=Expense Tracker API
API_VERSION=v1
OPENAPI_URL_PREFIX=/docs
OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/
